# Every browser session starts in Mock. Select a configured provider in the UI.
# Claude (guided), recommended: Claude reads what you type; Stillwater draws every screen.
# Option A: your Claude plan (Pro/Max) through the official claude CLI and its existing login.
ALLOW_CLAUDE_PLAN=false
# Option B (takes priority when set): an Anthropic API key.
# Enable only when you choose to use API budget. Typed messages are sent to Anthropic.
ALLOW_CLAUDE_API=false
ANTHROPIC_API_KEY=
# Blank = claude-opus-5-5.
ANTHROPIC_MODEL=
# OpenAIAPI: enable only when you choose to use API budget.
OPENAI_MODEL=gpt-6-luna
ALLOW_LIVE_API=false
OPENAI_API_KEY=
# ClaudeCLI: official installed executable and existing Claude-plan login.
# Read docs/RUNTIMES.md before acknowledging the host-policy limitations.
ALLOW_CLAUDE_CLI=false
CLAUDE_CLI_PATH=
CLI_PROFILE_ACKNOWLEDGED=false
# Blank = official CLI's default; returned model recorded when reported.
CLAUDE_MODEL=
# CodexCLI execution is intentionally disabled; no environment override.
PORT=4319
